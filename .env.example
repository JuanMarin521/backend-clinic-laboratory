# Puerto donde escucha el servidor HTTP
PORT=4000

# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Clave secreta para firmar los tokens JWT.
# En produccion es OBLIGATORIA, de al menos 32 caracteres y distinta a esta (si no, el servidor no arranca).
JWT_SECRET=cpo-conecta-dev-secret-change-me

# Tiempo de expiracion del token (formato soportado por jsonwebtoken: "2h", "7d", etc.)
JWT_EXPIRES_IN=2h

# Numero de "rondas" de encriptacion para las contrasenas (mayor = mas seguro y mas lento)
BCRYPT_SALT_ROUNDS=10

# Origenes permitidos para CORS: "*" o una lista separada por comas (ej. http://localhost:8081).
# Solo aplica a la version web; la app movil no lo necesita. En produccion no se permite "*".
CORS_ORIGIN=*

# Ruta del archivo de base de datos SQLite (se crea automaticamente si no existe)
DATABASE_PATH=./data/cpo-conecta.db

# Asistente con IA del chat (Google Gemini). OPCIONAL: si se deja vacia, el chat usa el asistente
# por palabras clave. La clave se crea gratis en https://aistudio.google.com/apikey
# NUNCA la pongas en la app ni la subas al repositorio (solo en el .env, que esta en .gitignore).
GEMINI_API_KEY=

# Modelo de Gemini a usar (lista en https://ai.google.dev/models)
GEMINI_MODEL=gemini-3.5-flash-lite
